# Google Gemini API (kostenlos via Google AI Studio)
# Hol dir deinen Key: https://aistudio.google.com/app/apikey
GOOGLE_AI_API_KEY=

# Supabase – Projekt-URL und anonymer Public Key
# Zu finden unter: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dein-anon-key-hier

# Supabase Service Role Key (NUR für Seed-Skripte, NIEMALS im Frontend verwenden!)
# Zu finden unter: Supabase Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=dein-service-role-key-hier

# UUID des Supabase-Users, dem die Seed-Projekte zugewiesen werden
# Zu finden unter: Supabase Dashboard → Authentication → Users → User-ID kopieren
SEED_USER_ID=deine-user-uuid-hier

# Datenbankschema: 'prod' für Strato, 'test' für Vercel, 'public' für lokale Entwicklung
# Steuert, welches Postgres-Schema der Supabase-Client verwendet.
NEXT_PUBLIC_DB_SCHEMA=public
